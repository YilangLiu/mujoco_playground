<mujoco model="go2 sample-apg crate scene">
  <!-- Crate-climbing scene for Go2SampleAPG: the collision-free robot PLUS
       the dial-mpc torso collision box (go2_mjx_crate_climb.xml — the climb
       rests the belly on the crate edge), and the dial-mpc crate
       (mjx_scene_force_crate.xml: box half-extents 0.31 0.46 0.3 at pos
       1.3 0 0.3 => top at z=0.6, front face at x=0.99). Rendered visibly
       here (the dial scene hides it with alpha 0). The home keyframe comes
       from the robot include and matches the model the sampled reference
       was generated on. -->
  <include file="go2_mjx_crate_climb.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="crate_material" shininess="0.1" specular="0.5"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
    <geom name="crate" type="box" size="0.31 0.46 0.3" pos="1.3 0 0.3"
      material="crate_material" rgba="0.87 0.72 0.53 1" priority="1" friction="1.0"/>
  </worldbody>
</mujoco>
