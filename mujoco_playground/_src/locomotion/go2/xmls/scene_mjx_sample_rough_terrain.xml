<mujoco model="go2 sample-apg rough terrain scene">
  <!-- Rough-terrain scene for Go2SampleAPG: the feet-only robot on the ±5 cm
       hfield, but with the SAME home keyframe as scene_mjx_collision_free.xml
       (joints 0 0.9 -1.8, z 0.27). Go2SampleAPG derives action_loc and the
       joint-angle observation offset from this keyframe, and the sampled
       references were generated in that action space — reusing the shared
       rough scene's keyframe (abduction +-0.1, z 0.35) would silently shift
       both. Do not "fix" this keyframe to match the shared scene. -->
  <include file="go2_mjx_feetonly.xml"/>

  <statistic center="0 0 0.1" extent="0.8" meansize="0.04"/>

  <visual>
    <rgba force="1 0 0 1"/>
    <global azimuth="120" elevation="-20"/>
    <map force="0.01"/>
    <scale forcewidth="0.3" contactwidth="0.5" contactheight="0.2"/>
    <quality shadowsize="8192"/>
  </visual>

  <asset>
    <!-- Untextured ground: the shared rocky_texture.png asset does not exist
         in this repo, and the depth camera doesn't see textures anyway.
         hfield.png is generated smooth noise (~31 cm features); referenced by
         basename because get_assets() keys assets by filename. -->
    <material name="groundplane" rgba="0.45 0.42 0.38 1" reflectance="0.1"/>
    <hfield name="hfield" file="hfield.png" size="10 10 .05 0.1"/>
  </asset>

  <worldbody>
    <geom name="floor" type="hfield" hfield="hfield" material="groundplane" contype="1" conaffinity="0" priority="1"
      friction="1.0"/>
  </worldbody>

  <include file="sensor_feet.xml"/>

  <keyframe>
    <key name="home" qpos="0 0 0.27 1 0 0 0 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8"
      ctrl="0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8"/>
  </keyframe>
</mujoco>
